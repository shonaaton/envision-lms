# VCS / tooling
.git
.gitignore
.claude
.vscode
.idea

# Dependencies & caches (reinstalled in the deps stage)
node_modules
.npm-cache
.turbo
.vercel

# Build output (regenerated by `npm run build`)
.next
.next-dev

# Secrets — never ship into the build context
.env
.env.*
!.env.example

# Logs & local run output
*.log
logs
test-results
playwright-report
blob-report

# Not needed to build or run the server
Dockerfile
docker-compose.yml
README.md
DEPLOY.md
docs
android-webview
android-sdk
n8n-workflows
*.bat

# Large data dumps
lichess_db_puzzle*.csv
lichess_db_puzzle*.zst
