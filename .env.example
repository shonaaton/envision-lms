# --- Mongo (your Atlas cluster) ---
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>/envision_chess?retryWrites=true&w=majority"
MONGODB_DB="envision_chess"

# --- NextAuth ---
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me"
# In production set to your public URL
NEXTAUTH_URL="https://platform.envisionchessacademy.com"

# --- Razorpay (use test keys first) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- App branding ---
NEXT_PUBLIC_APP_NAME="Envision Chess Academy"
NEXT_PUBLIC_BRAND_COLOR="#5a1372"
NEXT_PUBLIC_ACCENT_COLOR="#fde75a"
