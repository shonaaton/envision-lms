# ============================================================
# Envision Chess Academy LMS - environment configuration
# Copy to `.env` on the VPS and fill in real values.
# ============================================================

# --- Public URL (used by Traefik for routing + by NextAuth) ---
# Must match the docker-compose Host() label.
LMS_HOST="lms.srv1170212.hstgr.cloud"
NEXTAUTH_URL="https://lms.srv1170212.hstgr.cloud"
NEXT_PUBLIC_APP_URL="https://lms.srv1170212.hstgr.cloud"

# --- Mongo Atlas ---
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>/envision_chess?retryWrites=true&w=majority"
MONGODB_DB="envision_chess"

# --- NextAuth ---
# Generate on the VPS with: openssl rand -base64 32
AUTH_SECRET="change-me"

# --- Razorpay (use TEST keys first; swap to live after first test payment) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Public - exposed to the browser, same value as RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- App branding ---
NEXT_PUBLIC_APP_NAME="Envision Chess Academy"
NEXT_PUBLIC_BRAND_COLOR="#5a1372"
NEXT_PUBLIC_ACCENT_COLOR="#fde75a"

# --- n8n email automation webhooks ---
# Both can point to the same n8n workflow.
ASK_COACH_EMAIL_WEBHOOK_URL="https://n8n.srv1170212.hstgr.cloud/webhook/lms-email-automation"
EMAIL_AUTOMATION_WEBHOOK_URL="https://n8n.srv1170212.hstgr.cloud/webhook/lms-email-automation"
PASSWORD_RESET_EMAIL_WEBHOOK_URL="https://n8n.srv1170212.hstgr.cloud/webhook/lms-password-reset"

# Optional internal n8n base if you later switch to internal docker routing.
# N8N_WEBHOOK_BASE="http://root-n8n-1:5678/webhook"

# --- Google reviews ---
# Places API key can fetch public Google Place reviews shown by Google Places.
# Google Places returns a limited public review set; full Business Profile review history needs OAuth values below.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_QUERY="Envision Chess Academy Kolkata"
# Recommended in production. If API key restrictions block Text Search, set this manually.
GOOGLE_PLACE_ID=""
GOOGLE_BUSINESS_SHARE_URL="https://share.google/VKGkrmCKI3UGLIxEx"

# Optional: needed only when syncing the full Google Business Profile review list.
GOOGLE_BUSINESS_ACCOUNT_ID=""
GOOGLE_BUSINESS_LOCATION_ID=""
GOOGLE_BUSINESS_ACCESS_TOKEN=""
