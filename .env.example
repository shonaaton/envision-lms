# ============================================================
# Envision Chess Academy LMS - environment configuration
# Copy to `.env` on the VPS and fill in real values.
# ============================================================

# --- Public URLs ---
# Use the exact LMS subdomain you point to the VPS.
LMS_HOST="classroom.envisionchessacademy.com"
NEXTAUTH_URL="https://classroom.envisionchessacademy.com"
NEXT_PUBLIC_APP_URL="https://classroom.envisionchessacademy.com"

# Marketing/legal website.
NEXT_PUBLIC_MARKETING_URL="https://www.envisionchessacademy.com"
NEXT_PUBLIC_POLICY_BASE_URL="https://www.envisionchessacademy.com"

# --- Mongo Atlas ---
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>/envision_chess?retryWrites=true&w=majority"
MONGODB_DB="envision_chess"

# Redis live queue, lease, and result cache.
REDIS_URL="redis://engine-redis:6379"

# --- Shared Stockfish coordinator ---
# Comma-separated worker entries: workerId:secret:cores:displayName
# Store real secrets only in the deployment environment; they are hashed before persistence.
ENGINE_FISHNET_WORKERS="fishnet-01:replace-with-random-secret-1:2:Fishnet-01,fishnet-02:replace-with-random-secret-2:2:Fishnet-02,fishnet-03:replace-with-random-secret-3:2:Fishnet-03"
FISHNET_1_KEY="replace-with-random-secret-1"
FISHNET_2_KEY="replace-with-random-secret-2"
FISHNET_3_KEY="replace-with-random-secret-3"

# --- NextAuth ---
# Generate on the VPS with: openssl rand -base64 32
AUTH_SECRET="change-me"

# --- Razorpay (use TEST keys first; swap to live after first test payment) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Public - exposed to the browser, same value as RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- App branding ---
NEXT_PUBLIC_APP_NAME="Envision Chess Academy"
NEXT_PUBLIC_BRAND_COLOR="#5a1372"
NEXT_PUBLIC_ACCENT_COLOR="#fde75a"

# --- Meta Pixel / Conversions API ---
# Browser Pixel uses NEXT_PUBLIC_META_PIXEL_ID. Server CAPI uses META_PIXEL_ID and the access token.
NEXT_PUBLIC_META_PIXEL_ID="924225047079586"
META_PIXEL_ID="924225047079586"
META_CONVERSIONS_API_ACCESS_TOKEN=""

# --- n8n email automation webhooks ---
# Both can point to the same n8n workflow.
ASK_COACH_EMAIL_WEBHOOK_URL="https://n8n.envisionchessacademy.com/webhook/lms-email-automation"
EMAIL_AUTOMATION_WEBHOOK_URL="https://n8n.envisionchessacademy.com/webhook/lms-email-automation"
PASSWORD_RESET_EMAIL_WEBHOOK_URL="https://n8n.envisionchessacademy.com/webhook/lms-password-reset"

# Ask Coach messages create an in-app notification first. Email is sent only if the message
# is still unread after this grace period. A cron can call the protected reminder endpoint
# every minute as an optional second safeguard alongside the LMS background processor.
ASK_COACH_UNREAD_EMAIL_DELAY_MINUTES="5"
ASK_COACH_REMINDER_SECRET="change-me-to-a-long-random-value"

# Optional read-only server diagnostic endpoint for attendance/join mismatches.
# Leave blank to allow only logged-in admin/sub-admin access.
ATTENDANCE_DIAGNOSTIC_TOKEN=""

# Optional read-only server diagnostic endpoint for broad database inspection.
# Use a long random value. Responses redact password/token/secret fields.
DATABASE_DIAGNOSTIC_TOKEN=""

# Optional internal n8n base if you later switch to internal docker routing.
# N8N_WEBHOOK_BASE="http://root-n8n-1:5678/webhook"

# --- WhatsApp Cloud API reminders ---
# Testing mode sends every WhatsApp reminder to WHATSAPP_TEST_RECIPIENT only.
WHATSAPP_TEST_MODE="true"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_NUMBER_ID="1240465615818719"
WHATSAPP_TEST_RECIPIENT="918017996184"
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_TEMPLATE_BRIDGE_SECRET="change-me-to-a-long-random-value"
WHATSAPP_MESSAGE_MODE="template"
WHATSAPP_TEMPLATE_NAME="jaspers_market_order_confirmation_v1"
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_TEMPLATE_HAS_BODY_PARAM="true"
# Pipe-separated body values. Use "" for zero body params, "{studentName}" for one.
WHATSAPP_TEMPLATE_BODY_PARAMS="{studentName}"

# Important operational contacts.
# Format per contact: role:key:name:whatsapp_number:email
# Separate contacts with "|". Supported roles: admin, sub-admin, sales.
LMS_IMPORTANT_CONTACTS="admin:primary:Admin Name:919999999999:admin@example.com|sub-admin:sub_admin_1:Sub Admin Name:919999999998:subadmin@example.com|sales:sales_1:Sales Name:919999999997:sales@example.com"
# Optional comma-separated contact keys for workflows that should notify only specific people.
# Leave blank to notify every contact in that role.
DEMO_SALESPERSON_CONTACT_KEYS=""
DEMO_SUB_ADMIN_CONTACT_KEYS=""
DEMO_REMINDER_SECRET=""

# Comma-separated WhatsApp numbers for demo workflow notifications.
# Backward-compatible fallback only. LMS_IMPORTANT_CONTACTS is preferred when set.
DEMO_SALESPERSON_WHATSAPP_NUMBERS=""
DEMO_SUB_ADMIN_WHATSAPP_NUMBERS=""

# --- Google reviews ---
# Places API key can fetch public Google Place reviews shown by Google Places.
# Google Places returns a limited public review set; full Business Profile review history needs OAuth values below.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_QUERY="Envision Chess Academy Kolkata"
# Recommended in production. If API key restrictions block Text Search, set this manually.
GOOGLE_PLACE_ID=""
GOOGLE_BUSINESS_SHARE_URL="https://share.google/VKGkrmCKI3UGLIxEx"

# OAuth client for full Google Business Profile review sync.
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
GOOGLE_BUSINESS_REDIRECT_URI="https://classroom.envisionchessacademy.com/api/auth/google-business/callback"

# Optional fallback if you want to force one location manually.
GOOGLE_BUSINESS_ACCOUNT_ID=""
GOOGLE_BUSINESS_LOCATION_ID=""
GOOGLE_BUSINESS_ACCESS_TOKEN=""

# --- Kraya CRM lead sync ---
# Two-way sync between the portal demo pipeline and the CRM lead pipeline.
# Portal owns every demo stage; the CRM owns conversion and closure.

# Inbound: paste this same value into Kraya's Webhook Secret field. Kraya sends it
# as the X-KRAYA-WEBHOOK-SECRET header. Leave blank to reject all webhook calls.
# Webhook URL to configure in Kraya:
#   https://classroom.envisionchessacademy.com/api/crm/kraya/webhook
KRAYA_WEBHOOK_SECRET=""

# Outbound: the "Leads API" URL and API Key from Kraya integration settings.
# With either blank, the portal runs normally and simply does not push to the CRM.
KRAYA_API_URL=""
KRAYA_API_KEY=""

# The API URL is already the complete upsert endpoint and contains your workspace
# id, so no path is appended. Defaults below match Kraya documented Leads API.
KRAYA_API_KEY_HEADER="X-KRAYA-API-KEY"
KRAYA_LEAD_UPSERT_PATH=""
KRAYA_LEAD_UPSERT_METHOD="POST"

# Stage names must match the CRM pipeline labels exactly or the update is rejected.
CRM_PIPELINE_NAME="Leads"
CRM_STAGE_DEMO_REQUESTED="Demo Requested"
CRM_STAGE_DEMO_BOOKED="Demo Booked/Upcoming Demo"
CRM_STAGE_DEMO_NO_SHOW="Demo Class No Shows/Missed"
CRM_STAGE_DEMO_COMPLETED="Demo Completed"
CRM_STAGE_CURRENT_STUDENT="Current Student"

# Optional: pin exact inbound stage names instead of relying on fuzzy matching.
# Any stage not listed as a demo or converted stage closes the demo on the portal.
CRM_DEMO_STAGES=""
CRM_CONVERTED_STAGES=""

# Used when a portal phone number has no country code stored.
CRM_DEFAULT_COUNTRY_CODE="91"
