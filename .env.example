# ============================================================
# Envision Chess Academy LMS - environment configuration
# Copy to `.env` on the VPS and fill in real values.
# ============================================================

# --- Public URLs ---
# Use the exact LMS subdomain you point to the VPS.
LMS_HOST="www.classroom.envisionchessacademy.com"
NEXTAUTH_URL="https://www.classroom.envisionchessacademy.com"
NEXT_PUBLIC_APP_URL="https://www.classroom.envisionchessacademy.com"

# Marketing/legal website.
NEXT_PUBLIC_MARKETING_URL="https://www.envisionchessacademy.com"
NEXT_PUBLIC_POLICY_BASE_URL="https://www.envisionchessacademy.com"

# --- Mongo Atlas ---
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>/envision_chess?retryWrites=true&w=majority"
MONGODB_DB="envision_chess"

# --- NextAuth ---
# Generate on the VPS with: openssl rand -base64 32
AUTH_SECRET="change-me"

# --- Razorpay (use TEST keys first; swap to live after first test payment) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Public - exposed to the browser, same value as RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- App branding ---
NEXT_PUBLIC_APP_NAME="Envision Chess Academy"
NEXT_PUBLIC_BRAND_COLOR="#5a1372"
NEXT_PUBLIC_ACCENT_COLOR="#fde75a"

# --- n8n email automation webhooks ---
# Both can point to the same n8n workflow.
ASK_COACH_EMAIL_WEBHOOK_URL="https://n8n.envisionchessacademy.com/webhook/lms-email-automation"
EMAIL_AUTOMATION_WEBHOOK_URL="https://n8n.envisionchessacademy.com/webhook/lms-email-automation"
PASSWORD_RESET_EMAIL_WEBHOOK_URL="https://n8n.envisionchessacademy.com/webhook/lms-password-reset"

# Optional internal n8n base if you later switch to internal docker routing.
# N8N_WEBHOOK_BASE="http://root-n8n-1:5678/webhook"

# --- WhatsApp Cloud API reminders ---
# Testing mode sends every WhatsApp reminder to WHATSAPP_TEST_RECIPIENT only.
WHATSAPP_TEST_MODE="true"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID="1240465615818719"
WHATSAPP_TEST_RECIPIENT="918017996184"
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_MESSAGE_MODE="template"
WHATSAPP_TEMPLATE_NAME="jaspers_market_order_confirmation_v1"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_TEMPLATE_HAS_BODY_PARAM="true"
# Pipe-separated body values. Use "" for zero body params, "{studentName}" for one.
WHATSAPP_TEMPLATE_BODY_PARAMS="{studentName}"

# --- Google reviews ---
# Places API key can fetch public Google Place reviews shown by Google Places.
# Google Places returns a limited public review set; full Business Profile review history needs OAuth values below.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_QUERY="Envision Chess Academy Kolkata"
# Recommended in production. If API key restrictions block Text Search, set this manually.
GOOGLE_PLACE_ID=""
GOOGLE_BUSINESS_SHARE_URL="https://share.google/VKGkrmCKI3UGLIxEx"

# OAuth client for full Google Business Profile review sync.
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
GOOGLE_BUSINESS_REDIRECT_URI="https://www.classroom.envisionchessacademy.com/api/auth/google-business/callback"

# Optional fallback if you want to force one location manually.
GOOGLE_BUSINESS_ACCOUNT_ID=""
GOOGLE_BUSINESS_LOCATION_ID=""
GOOGLE_BUSINESS_ACCESS_TOKEN=""
